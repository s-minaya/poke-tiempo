{
  "name": "poke-tiempo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && stylelint \"src/**/*.scss\"",
    "preview": "vite preview",
    "build:locations": "tsx --env-file-if-exists=.env scripts/build-locations.ts",
    "build:map": "tsx scripts/build-map.ts",
    "fetch:forecast": "tsx --env-file-if-exists=.env scripts/fetch-forecast.ts",
    "generate:oak": "tsx --env-file-if-exists=.env scripts/oak/generate.ts"
  },
  "dependencies": {
    "opentype.js": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "d3-geo": "^3.1.1",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "sass": "^1.104.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
