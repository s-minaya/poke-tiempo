# Copia este archivo a .env y pon tu clave real.
# Se solicita en https://opendata.aemet.es/centrodedescargas/inicio → "Solicitar API Key"
# Llega por correo y es un token largo tipo JWT. Caduca en 3 meses desde que se genera: si el fetch empieza a dar 401, renuévala.
AEMET_API_KEY=

# Clave de Groq para los diálogos del Profesor Oak (007).
# Se pide en https://console.groq.com → API Keys. Sin ella la generación no falla:
# Oak usa su fallback local, que es contenido de producto, no un mensaje de error.
# Nunca con prefijo VITE_: no puede acabar en el bundle del navegador.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
